# Copy to .env and fill in. See README "Setup" for where each value comes from.

# LiveKit Cloud project (lk cloud auth && lk app env -w, or dashboard -> Settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AgentPhone
AGENTPHONE_API_KEY=
AGENTPHONE_NUMBER=+1XXXXXXXXXX
AGENTPHONE_NUMBER_ID=
OPENDOOR_AGENTPHONE_AGENT_ID=

# AgentPhone SIP trunk (create it in the dashboard; the password is shown once)
AGENTPHONE_SIP_TRUNK_ID=
AGENTPHONE_SIP_TERMINATION_URI=sips:xxxx.pstn.agentphone.ai:5062
AGENTPHONE_SIP_USERNAME=
AGENTPHONE_SIP_PASSWORD=

# Printed by: uv run python scripts/setup_livekit_sip.py
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_DISPATCH_RULE_ID=

# Your public tunnel URL (cloudflared tunnel --url http://localhost:8000)
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com
# Written by: uv run python scripts/register_webhook.py <PUBLIC_BASE_URL>/webhooks/agentphone
OPENDOOR_WEBHOOK_SECRET=
